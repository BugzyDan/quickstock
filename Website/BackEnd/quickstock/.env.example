# QuickStock production environment template
# Copy this to /etc/quickstock/quickstock.env on the server and replace placeholders.
# Do not commit the real server env file.

DJANGO_SECRET_KEY=replace-me-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=quickstockja.com,www.quickstockja.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://quickstockja.com,https://www.quickstockja.com

# Database
# Render Postgres provides DATABASE_URL automatically. If DATABASE_URL is set,
# it takes precedence over the DJANGO_DB_* values below.
# DATABASE_URL=postgresql://quickstock_user:replace-me@host:5432/quickstock_prod
DJANGO_DB_ENGINE=django.db.backends.mysql
DJANGO_DB_NAME=quickstock_prod
DJANGO_DB_USER=quickstock_user
DJANGO_DB_PASSWORD=replace-me
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=3306

# HTTPS and browser security
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DJANGO_SECURE_REFERRER_POLICY=same-origin

# Email
# Render free web services block SMTP ports. Use Resend over HTTPS on Render.
QUICKSTOCK_EMAIL_PROVIDER=resend
RESEND_API_KEY=replace-me-with-a-resend-sending-key
DJANGO_DEFAULT_FROM_EMAIL=QuickStock JA <noreply@your-verified-domain.example>
DJANGO_EMAIL_TIMEOUT=5
QUICKSTOCK_EMAIL_TEST_RECIPIENT=owner@example.com

# SMTP fallback for local development or a host that permits SMTP.
# QUICKSTOCK_EMAIL_PROVIDER=smtp
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=replace-me@example.com
# DJANGO_EMAIL_HOST_PASSWORD=replace-me
# DJANGO_EMAIL_USE_TLS=True

# Shared cache (recommended when running multiple workers)
DJANGO_CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
DJANGO_CACHE_LOCATION=quickstock_cache

# Optional idempotent production administrator bootstrap
QUICKSTOCK_SUPERUSER_USERNAME=
QUICKSTOCK_SUPERUSER_EMAIL=
QUICKSTOCK_SUPERUSER_PASSWORD=
QUICKSTOCK_SUPERUSER_RESET_PASSWORD=False

# Optional social sign-in
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT_ID=common

# Persistent media for receipt logos (S3, Cloudflare R2, Backblaze B2, etc.)
# QUICKSTOCK_MEDIA_STORAGE=s3
# QUICKSTOCK_REQUIRE_PERSISTENT_MEDIA=True
# AWS_STORAGE_BUCKET_NAME=quickstock-media
# AWS_ACCESS_KEY_ID=replace-me
# AWS_SECRET_ACCESS_KEY=replace-me
# AWS_S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
# AWS_S3_REGION_NAME=auto
# AWS_S3_CUSTOM_DOMAIN=media.quickstockja.com

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=False

# WiPay
WIPAY_ACCOUNT_NUMBER_SANDBOX=replace-me
WIPAY_API_KEY_SANDBOX=replace-me
WIPAY_ACCOUNT_NUMBER_LIVE=replace-me
WIPAY_API_KEY_LIVE=replace-me
WIPAY_ENVIRONMENT=live
WIPAY_ALLOW_SANDBOX_IN_PROD=False
WIPAY_FEE_STRUCTURE=merchant_absorb
WIPAY_METHOD=credit_card
WIPAY_ORIGIN=QuickStock
WIPAY_COUNTRY_CODE=JM
WIPAY_CURRENCY=JMD
WIPAY_ENDPOINT=https://jm.wipayfinancial.com/plugins/payments/request
WIPAY_PRO_PRICE=30400.00
WIPAY_PRO_PRICE_MONTHLY=2600.00

# Optional payment integrations
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
JAMDEX_API_URL=
JAMDEX_MERCHANT_ID=
JAMDEX_API_KEY=
JAMDEX_CALLBACK_SECRET=

# Accounting integrations
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=https://quickstockja.com/login/xero/callback/
XERO_WEBHOOK_KEY=
ACCOUNTING_SYNC_BATCH_SIZE=50

# Gunicorn
GUNICORN_BIND=unix:/run/quickstock/gunicorn.sock
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
GUNICORN_LOGLEVEL=info

# App controls
AUDIT_LOG_RETENTION_DAYS=90
TIME_ZONE=America/Jamaica
API_TOKEN_MAX_AGE=86400
API_LOGIN_RATE_LIMIT_ATTEMPTS=10
API_LOGIN_RATE_LIMIT_WINDOW=300
API_SYNC_MAX_INVENTORY_ITEMS=1000
API_SYNC_MAX_SALES=500
POS_CART_MAX_LINES=200
POS_INITIAL_ITEMS_LIMIT=50
POS_SEARCH_RESULT_LIMIT=30

# Backups
BACKUP_DIR=/var/backups/quickstock
BACKUP_RETENTION_DAYS=14
BACKUP_POST_HOOK=
