# QuickStock JA Desktop Client Configuration
# Copy this file to .env beside Desktop_UI/main.py on Windows.

# For Render, use your deployed HTTPS app URL, for example:
# API_BASE_URL=https://your-app-name.onrender.com
API_BASE_URL=http://localhost:8000

# Use production when API_BASE_URL points to Render.
QUICKSTOCK_ENV=development

QUICKSTOCK_LOG_LEVEL=INFO
